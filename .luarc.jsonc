{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "codeLens.enable": true,
  "hint.enable": true,
  "hint": {
    "arrayIndex": "Auto",
    "await": true,
    "awaitPropagate": true,
    "enable": true,
    "paramName": "All",
    "paramType": true,
    "semicolon": "SameLine",
    "setType": true
  }
}
